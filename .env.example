APP_ENV=development
DATABASE_URL=postgres://fakturomat:fakturomat@localhost:55433/fakturomat
DATABASE_MAX_CONNECTIONS=10
# Public origin of this deployment (without a trailing path).
BETTER_AUTH_URL=http://localhost:5173
# Generate once with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-base64-secret
STORAGE_LOCAL_ROOT=./data/storage
# Generate once with: openssl rand -base64 32
BANK_CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Used only by `deno task user:create`; remove the password after bootstrap.
FAKTUROMAT_ADMIN_EMAIL=admin@example.test
FAKTUROMAT_ADMIN_NAME=Admin
FAKTUROMAT_ADMIN_PASSWORD=replace-with-at-least-12-characters
