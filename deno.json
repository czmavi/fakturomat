{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test -A",
    "test:startup": "deno task build && deno run -A scripts/check_worker_startup.ts",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "user:create": "deno run --allow-env --allow-read --allow-write --env-file=.dev.vars scripts/create_user.ts",
    "dev": "deno task build && deno task start",
    "build": "vite build",
    "start": "wrangler dev --config _fresh/server/wrangler.json --port 5173 --persist-to .wrangler/state",
    "update": "deno run -A -r jsr:@fresh/update .",
    "deploy": "deno task build && wrangler deploy",
    "data:export": "deno run --allow-env=SOURCE_DATABASE_URL --allow-net --allow-read --allow-write scripts/export_postgres_to_d1.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "tests/legacy_postgres",
    "scripts/check_built_startup.ts",
    ".wrangler",
    "vite.config.ts.timestamp-*.mjs",
    ".vite"
  ],
  "imports": {
    "@/": "./",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.1132.0",
    "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.1132.0",
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@^1.64.0",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@1.1.1",
    "@types/pg": "npm:@types/pg@8.15.5",
    "better-auth": "npm:better-auth@1.6.26",
    "dejavu-fonts-ttf": "npm:dejavu-fonts-ttf@2.37.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "miniflare": "npm:miniflare@5.20261012.1-beta",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "pg": "npm:pg@8.16.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@std/path": "jsr:@std/path@^1.1.6",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@types/qrcode": "npm:@types/qrcode@^1.5.6",
    "postgres": "npm:postgres@^3.4.7",
    "qrcode/core": "npm:qrcode@1.5.4/lib/core/qrcode.js",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "wrangler": "npm:wrangler@^4.151.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
