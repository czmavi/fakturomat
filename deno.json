{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test -A",
    "db:migrate": "deno run -A --env-file=.env database/migrate.ts",
    "user:create": "deno run -A --env-file=.env scripts/create_user.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@1.1.1",
    "@types/pg": "npm:@types/pg@8.15.5",
    "better-auth": "npm:better-auth@1.6.26",
    "dejavu-fonts-ttf": "npm:dejavu-fonts-ttf@2.37.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "pg": "npm:pg@8.16.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@std/path": "jsr:@std/path@^1.1.6",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@types/qrcode": "npm:@types/qrcode@^1.5.6",
    "postgres": "npm:postgres@^3.4.7",
    "qrcode/core": "npm:qrcode@1.5.4/lib/core/qrcode.js",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
