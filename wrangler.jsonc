{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakturomat",
  "main": "./server.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://fakturomat.caretsix.com",
    "OPENAI_EXPENSE_MODEL": "gpt-6.1-sol"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fakturomat",
      "database_id": "868e9044-22a4-4a67-8454-7f9cc38ba71c",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "fakturomat-documents"
    },
    {
      "binding": "FILES",
      "bucket_name": "fakturomat-files"
    }
  ]
}
